# Copy to infra/params.env (gitignored) and fill in your account's values.
AWS_REGION=us-east-2
STACK=rendezvous
DOMAIN=example.app                # a domain whose hosted zone lives in Route 53
HOSTED_ZONE_ID=ZXXXXXXXXXXXXX     # Route 53 hosted zone for DOMAIN
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
SUBNET_IDS=subnet-aaa,subnet-bbb  # public subnets in >= 2 AZs (ALB + Fargate tasks; RDS gets no public IP)
STRIPE_PORTAL_CONFIG_ID=          # optional: Stripe billing-portal configuration id (bpc_...)
PAYMENT_LINK_URL=                 # optional: Stripe Payment Link for the CURRENT seeker price, shown on /pricing (never point this at the old $5 founder link)
MAIL_FROM=""                      # e.g. "Rendezvous <matchmaker@agentrendezvous.app>" (quote it: the angle brackets) — SES identity must be verified; empty disables mail
INTERVIEW_MODEL=claude-sonnet-5   # model for the be-found interview
REPRESENTATIVE_ENABLED=false      # run the representative scheduler (needs the Anthropic key; bounded model calls)
MATCHMAKER_NAME=                  # persona name; empty = "your matchmaker"
STRIPE_FOUNDER_PRICE_ID=          # the original $5 founding price id, so founding members are still recognised after STRIPE_PRICE_ID moves to the new price
AMBASSADOR_ENABLED=false          # Moltbook ambassador scheduler
AMBASSADOR_AUTO_COMMENTS=false    # charter: pre-approval for the first 30 days
JUNE_ENABLED=false               # mount the June matchmaker at /meet
JUNE_SCHEDULER_ENABLED=false     # run June's matchmaking cycle
