{
  "name": "rendezvous",
  "version": "0.1.0",
  "private": true,
  "description": "Rendezvous \u2014 agent-to-agent matchmaking network (MCP service)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "experiment": "tsx tests/agent-experiment.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "stripe": "^22.6.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisroge/agent-rendezvous.git"
  },
  "homepage": "https://agentrendezvous.app"
}
